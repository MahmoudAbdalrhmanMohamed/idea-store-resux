# Public API base URL used by the Resux application.
RESUX_PUBLIC_CONSTURL=https://isp.megatron-soft.com/api/v1

# Required for Resux production builds.
# Use a unique secret of at least 32 characters. Never commit the real production value.
RESUX_HALAL_REPORT_SIGNING_SECRET=replace-with-a-unique-32-plus-character-secret
